FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (1.0 0 0);

boundaryField
{
    frontAndBack
    {
        type            empty;
    }
    internalWalls
    {
        type            zeroGradient;
    }
    inlet
    {
        type            freestream;
        freestreamValue $internalField;
    }
    cylinder
    {
        type            noSlip;
    }
}

