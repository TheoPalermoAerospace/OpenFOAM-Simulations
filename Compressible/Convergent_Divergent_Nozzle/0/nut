FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 0; // 0.14 or 00000858
    }
    atmosphera
    {
        type            calculated;
        value           uniform 0; // 0.14 or 00000858
    }
    nozzle
    {
        type            nutkWallFunction;
        value           uniform 0;
    }
    wedge_1
    {
        type            wedge;
    }

    wedge_2
    {
        type            wedge;
    }
}


