FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      Ma;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Campo derivado (adimensional): Ma = |U| / sqrt(γ * p / ρ)
// Calculado automaticamente pelo solver a cada passo de tempo.
// Valores de referência para este caso (NPR ≈ 4.93):
//   Inlet (subsônico)   : Ma << 1  (≈ 0.05–0.10)
//   Saída do bocal      : Ma = 1   (garganta chocada)
//   Jato sub-expandido  : Ma > 1   (leque de expansão → Ma ≈ 1.5–2.5)
//   Choques oblíquos    : Ma cai localmente dentro dos diamonds
//   Atmosfera far-field : Ma → 0

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;      // inicialização em repouso (t = 0)

boundaryField
{
    inlet
    {
        // Ma calculado a partir de U e das propriedades termodinâmicas locais.
        // Não é imposto: o solver resolve a velocidade via totalPressure/totalTemperature.
        type            calculated;
        value           uniform 0;
    }
    atmosphera
    {
        // Far-field: Ma ≈ 0 fora do jato.
        type            calculated;
        value           uniform 0;
    }
    nozzle
    {
        // Parede: velocidade de escorregamento nulo → Ma na parede é residual.
        type            calculated;
        value           uniform 0;
    }
    wedge_1
    {
        type            wedge;
    }
    wedge_2
    {
        type            wedge;
    }
}

