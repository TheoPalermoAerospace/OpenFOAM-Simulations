FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Estimativa: ω = sqrt(k) / (Cμ^0.25 * L_turb)
// L_turb ≈ 0.07 * D_throat = 0.07 * 0.05 = 0.0035 m
// ω_inlet = sqrt(5) / (0.5477 * 0.0035) ≈ 1167 s⁻¹  →  arredondado para 1100
// Consistente com k_inlet = 5.0 m²/s²

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 10.5;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 1100;   // consistente com k_inlet = 5.0
    }
    atmosphera
    {
        type            inletOutlet;
        inletValue      uniform 10.5;
        value           $internalField;
    }
    nozzle
    {
        type            omegaWallFunction;
        value           uniform 0;
    }
    wedge_1
    {
        type            wedge;
    }
    wedge_2
    {
        type            wedge;
    }
}

