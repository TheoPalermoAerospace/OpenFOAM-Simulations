FoamFile
{
    version	 2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 2372;

boundaryField
{    
    frontAndBack
    {
        type            empty;
    }
    inlet
    {
        type            fixedValue;
        value           uniform 25000;
    }
    outlet
    {
        type            zeroGradient;
    }
    symmetry
    {
    	type            symmetryPlane;
    }
    wall
    {
        type            zeroGradient;
    }
}


