FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 18485;

boundaryField
{
    inlet
    {
        type            totalPressure;
        p0              uniform 2.53e+06;
        gamma           1.4;
        psi             thermo:psi;
        value           uniform 2.53e+06;
    }
    outlet
    {
        type            waveTransmissive; // saida supersonica, nao-reflexiva
        field           p;
        psi             thermo:psi;
        gamma           1.4;
        fieldInf        18485;
        lInf            0.1;
        value           uniform 18485;
    }
    wall
    {
        type            zeroGradient;
    }
    wedge_front
    {
        type            wedge;
    }
    wedge_back
    {
        type            wedge;
    }
}


