FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 298;

boundaryField
{
    inlet
    {
        type            totalTemperature;
        T0              uniform 1461;
        gamma           1.4;
        psi             thermo:psi;
        value           uniform 1461;
    }
    outlet
    {
        type            zeroGradient;
    }
    wall
    {
        type            zeroGradient;   // parede adiabatica
    }
    wedge_front
    {
        type            wedge;
    }
    wedge_back
    {
        type            wedge;
    }
}


