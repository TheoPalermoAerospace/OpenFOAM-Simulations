FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.375;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           nonuniform List<scalar> 0();
    }
    atmosphera
    {
        type            inletOutlet;
        inletValue      uniform 0.375;
        value           uniform 0.375;
    }
    wedge_2
    {
        type            wedge;
    }
    nozzle
    {
        type            kqRWallFunction;
        value           uniform 0;
    }
    wedge_1
    {
        type            wedge;
    }
    procBoundary2to1
    {
        type            processor;
        value           uniform 0.375;
    }
}


