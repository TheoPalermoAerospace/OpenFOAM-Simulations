FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 10.5;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           nonuniform List<scalar> 0();
    }
    atmosphera
    {
        type            inletOutlet;
        inletValue      uniform 10.5;
        value           uniform 10.5;
    }
    wedge_2
    {
        type            wedge;
    }
    nozzle
    {
        type            omegaWallFunction;
        value           uniform 0;
    }
    wedge_1
    {
        type            wedge;
    }
    procBoundary2to1
    {
        type            processor;
        value           uniform 10.5;
    }
}


