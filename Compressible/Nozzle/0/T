FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300;

boundaryField
{
    inlet
    {
        type            totalTemperature;
        gamma           1.4;
        T0              nonuniform List<scalar> 0();
        value           nonuniform List<scalar> 0();
    }
    atmosphera
    {
        type            inletOutlet;
        inletValue      uniform 300;
        value           uniform 300;
    }
    wedge_2
    {
        type            wedge;
    }
    nozzle
    {
        type            zeroGradient;
    }
    wedge_1
    {
        type            wedge;
    }
    procBoundary2to1
    {
        type            processor;
        value           uniform 300;
    }
}


